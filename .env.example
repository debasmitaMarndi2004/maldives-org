# Optional: canonical origin for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://maldives.org

# Optional private admin. Use a dedicated database and a 32-byte random auth secret.
# ADMIN_DATABASE_URL=postgresql://user:password@host/database
# ADMIN_ORIGIN=https://www.maldives.org
# ADMIN_AUTH_SECRET=
# ADMIN_AUTH_MODE=otp
# Set ADMIN_AUTH_MODE=password for password sign-in. Sender settings apply to OTP mode.
# ADMIN_OTP_RESEND_KEY=
# ADMIN_OTP_FROM=Maldives.org Admin <admin-auth@example.com>
# ADMIN_GITHUB_REPO=debasmitaMarndi2004/maldives-org
# ADMIN_GITHUB_BRANCH=master
# ADMIN_GITHUB_READ_TOKEN=
